# Example local paths for RMD-X reproduction.
# Copy this file to paths.env and edit it for your machine.

RAXO_REPO=/workspace/RAXO
RAXO_DATASET_ROOT=/datasets/xray-datasets
RAXO_MODEL_ROOT=/models/ICCV25_experimentation

DET_COMPASS_ANNOTATION=/datasets/xray-datasets/DET-COMPASS/annotations/full_test.json
DET_COMPASS_IMAGE_DIR=/datasets/xray-datasets/DET-COMPASS/test
KNOWN_PROTOTYPES=/models/ICCV25_experimentation/known_prototypes_sam2.pt

GROUNDINGDINO_WITH_MASKS=/models/ICCV25_experimentation/initial_detections/groundingDINO/coco_results.bbox_DET-COMPASS_with_masks.json
MATERIAL_BANK=/workspace/RAXO/outputs_rmdx/material/material_colour_bank_support_full_bbox_only.json
RMDX_CACHE=/workspace/RAXO/outputs_rmdx/cache/det_compass_groundingDINO_100_0_full

# Multi-detector DET-COMPASS resources.
VLDET_WITH_MASKS=/models/ICCV25_experimentation/initial_detections/VLDet/coco_results.bbox_DET-COMPASS_with_masks.json
CODET_WITH_MASKS=/models/ICCV25_experimentation/initial_detections/CoDet/coco_results.bbox_DET-COMPASS_with_masks.json

# Multi-dataset annotation/image roots.
PIXRAY_ANNOTATION=/datasets/xray-datasets/PIXray/annotations/full_test.json
PIXRAY_IMAGE_DIR=/datasets/xray-datasets/PIXray/test
PIDRAY_ANNOTATION=/datasets/xray-datasets/pidray/annotations/full_test.json
PIDRAY_IMAGE_DIR=/datasets/xray-datasets/pidray/test
CLCXray_ANNOTATION=/datasets/xray-datasets/CLCXray/annotations/full_test.json
CLCXray_IMAGE_DIR=/datasets/xray-datasets/CLCXray/test
HIXRAY_ANNOTATION=/datasets/xray-datasets/HiXray/annotations/full_test.json
HIXRAY_IMAGE_DIR=/datasets/xray-datasets/HiXray/test
DVXRAY_ANNOTATION=/datasets/xray-datasets/DvXray/annotations/full_test.json
DVXRAY_IMAGE_DIR=/datasets/xray-datasets/DvXray/test

# Multi-dataset GroundingDINO with-mask pattern.
GROUNDINGDINO_DET_ROOT=/models/ICCV25_experimentation/initial_detections/groundingDINO
